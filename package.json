{
  "name": "todo-app",
  "private": true,
  "description": "Full-stack TODO app: React + React Query / Express + Prisma + PostgreSQL",
  "scripts": {
    "db:up": "docker compose up -d",
    "install:all": "npm install && npm install --prefix server && npm install --prefix client",
    "migrate": "npm run prisma:migrate --prefix server",
    "dev": "concurrently -n server,client -c green,cyan --kill-others-on-fail \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "build": "npm run build --prefix client",
    "lint": "npm run lint --prefix client"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
